---
/**
 * Pino de localização do topo, com os resultados reais da Inove em volta.
 */
import Icon from './Icon.astro'
import { destaquesInove } from '../conteudo'
---

<div class="pino-cena" aria-label={`${destaquesInove.legenda}: ${destaquesInove.itens.map((d) => `${d.valor} ${d.texto}`).join(', ')}`} role="img">
  <div class="pino-chao"></div>
  <svg class="pino-svg" viewBox="0 0 200 270" aria-hidden="true">
    <defs>
      <linearGradient id="pino-cor" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#70c5f8" />
        <stop offset="0.45" stop-color="#3b9ee8" />
        <stop offset="1" stop-color="#103a6a" />
      </linearGradient>
      <radialGradient id="pino-brilho" cx="0.32" cy="0.25" r="0.5">
        <stop offset="0" stop-color="#fff" stop-opacity="0.55" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </radialGradient>
    </defs>
    <path d="M100 262C100 262 14 168 14 100a86 86 0 0 1 172 0c0 68-86 162-86 162Z" fill="url(#pino-cor)" />
    <path d="M100 262C100 262 14 168 14 100a86 86 0 0 1 172 0c0 68-86 162-86 162Z" fill="url(#pino-brilho)" />
    <circle cx="100" cy="98" r="38" fill="#080c14" />
    <circle cx="100" cy="98" r="16" fill="#70c5f8" />
  </svg>
  {
    destaquesInove.itens.map((d, i) => (
      <div class={`balao balao-${i + 1}`} style={`--i:${i}`} aria-hidden="true">
        <span class="balao-icone">
          <Icon name={d.icone as any} class="size-4" />
        </span>
        <span>
          <span class="balao-valor block">{d.valor}</span>
          <span class="balao-texto block">{d.texto}</span>
        </span>
      </div>
    ))
  }
  <p class="pino-legenda" aria-hidden="true">{destaquesInove.legenda}</p>
</div>
