<script>
  // Menu do celular: abre e fecha no botão; fecha ao escolher um item.
  const menu = document.getElementById('menu')!
  const botao = menu.querySelector<HTMLButtonElement>('.menu-btn')!
  const alternar = (abrir: boolean) => {
    menu.classList.toggle('aberto', abrir)
    botao.setAttribute('aria-expanded', String(abrir))
    botao.setAttribute('aria-label', abrir ? 'Fechar menu' : 'Abrir menu')
  }
  botao.addEventListener('click', () => alternar(!menu.classList.contains('aberto')))
  menu.querySelectorAll('ul a').forEach((link) => link.addEventListener('click', () => alternar(false)))

  const parado = matchMedia('(prefers-reduced-motion: reduce)').matches

  // Blocos que aparecem ao rolar.
  const revelados = document.querySelectorAll('.revelar')
  if (parado || !('IntersectionObserver' in window)) {
    revelados.forEach((el) => el.classList.add('visivel'))
  } else {
    const observador = new IntersectionObserver(
      (entradas) =>
        entradas.forEach((e) => {
          if (!e.isIntersecting) return
          e.target.classList.add('visivel')
          observador.unobserve(e.target)
        }),
      { rootMargin: '0px 0px -8% 0px' },
    )
    revelados.forEach((el) => observador.observe(el))
  }

  // Contadores: sobem do zero até o número escrito, mantendo as mesmas casas decimais
  // (10.34k+ termina em 10.34k+, e não em 10.3k+). Valores como "R$6,06", "Top 1" e "Ativo" ficam como estão.
  const contar = (el: HTMLElement) => {
    const final = el.textContent!.trim()
    const partes = final.match(/^(\d+)(?:\.(\d+))?(\D*)$/)
    if (!partes) return
    const casas = partes[2]?.length ?? 0
    const alvo = Number(`${partes[1]}.${partes[2] ?? 0}`)
    const sufixo = partes[3]
    const duracao = 1600
    let inicio = 0
    const passo = (agora: number) => {
      inicio ||= agora
      const p = Math.min((agora - inicio) / duracao, 1)
      const suave = 1 - Math.pow(1 - p, 3)
      el.textContent = p < 1 ? (alvo * suave).toFixed(casas) + sufixo : final
      if (p < 1) requestAnimationFrame(passo)
    }
    requestAnimationFrame(passo)
  }
  if (!parado && 'IntersectionObserver' in window) {
    const observador = new IntersectionObserver(
      (entradas) =>
        entradas.forEach((e) => {
          if (!e.isIntersecting) return
          e.target.querySelectorAll<HTMLElement>('.hstat-n, .metric-n').forEach(contar)
          observador.unobserve(e.target)
        }),
      { threshold: 0.3 },
    )
    document.querySelectorAll('[data-contadores]').forEach((el) => observador.observe(el))
  }
</script>
