---
/**
 * Site do Victor Eduardo (victoreduardo.vercel.app).
 * Os textos e números ficam em src/conteudo.ts; aqui fica só a montagem das seções.
 */
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import Pino from '../components/Pino.astro'
import LogoCliente from '../components/LogoCliente.astro'
import rosto from '../assets/rosto.webp'
import perfil from '../assets/perfil.webp'
import feedback1 from '../assets/feedback1.webp'
import feedback2 from '../assets/feedback2.webp'
import feedback3 from '../assets/feedback3.webp'
import {
  contato,
  seo,
  topo,
  numeros,
  clientes,
  problema,
  servicos,
  processo,
  cases,
  depoimentos,
  antesDepois,
  sobre,
  faq,
  chamadaFinal,
} from '../conteudo'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Victor Eduardo · Marketing para Serviços & Facilities',
  url: 'https://victoreduardo.vercel.app/',
  image: 'https://victoreduardo.vercel.app/og.jpg',
  telephone: contato.telefone,
  email: contato.email,
  areaServed: 'Paraná',
  address: { '@type': 'PostalAddress', addressLocality: 'Curitiba', addressRegion: 'PR', addressCountry: 'BR' },
  founder: { '@type': 'Person', name: 'Victor Eduardo', jobTitle: 'Gestor de Mídias' },
  sameAs: [contato.instagram],
}

const prints = [feedback1, feedback2, feedback3].map((img, i) => ({ img, quem: depoimentos.quem[i] }))

// O título do topo vira palavras soltas para cada uma subir na sua vez.
let ordem = 0
const palavras = (frase: string) => frase.split(' ').map((p) => ({ p, i: ordem++ }))
const linha1 = palavras(topo.titulo[0])
const linha2 = palavras(topo.titulo[1])

const menu = [
  { href: '#servicos', texto: 'Serviços' },
  { href: '#cases', texto: 'Cases' },
  { href: '#sobre', texto: 'Sobre' },
  { href: '#faq', texto: 'FAQ' },
]
---

<Base title={seo.titulo} description={seo.descricao} jsonLd={jsonLd}>
  <div class="progresso" aria-hidden="true"></div>

  <!-- ═══════ CABEÇALHO ═══════ -->
  <header class="cabecalho" id="cabecalho">
    <div class="caixa cabecalho-linha">
      <a href="#topo" class="logo"><span class="logo-ponto"></span>Victor Eduardo</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-links" aria-label="Abrir menu">
        <span></span>
      </button>
      <nav aria-label="Principal">
        <ul class="menu-links" id="menu-links">
          {menu.map((item) => <li><a href={item.href}>{item.texto}</a></li>)}
          <li><a href="#contato" class="botao botao-azul">Falar agora</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <!-- ═══════ 1. TOPO ═══════ -->
    <section class="topo grade" id="topo">
      <div class="topo-luz" aria-hidden="true"></div>
      <div class="caixa">
        <div class="topo-grade">
          <div>
            <span class="topo-selo entrar"><span class="ponto"></span>{topo.selo}</span>
            <div class="autor entrar" style="--i:1">
              <Image src={rosto} alt="" width={52} height={52} densities={[1, 2]} loading="eager" />
              <div>
                <div class="autor-nome">Victor Eduardo</div>
                <div class="autor-cargo">{topo.cargo}</div>
              </div>
            </div>
            <h1>
              {linha1.map(({ p, i }) => <Fragment><span class="palavra" style={`--i:${i}`}>{p}</span> </Fragment>)}
              <span class="linha2">
                {linha2.map(({ p, i }) => <Fragment><span class="palavra" style={`--i:${i}`}>{p}</span> </Fragment>)}
              </span>
            </h1>
            <p class="topo-texto entrar" style="--i:5" set:html={topo.texto} />
            <div class="topo-botoes entrar" style="--i:6">
              <a href={contato.whatsappDiagnostico} class="botao botao-azul">
                <Icon name="clipboard-check" />
                {topo.botao}
              </a>
              <a href="#cases" class="botao botao-vazado">
                {topo.botaoSecundario}
                <Icon name="arrow-right" class="seta size-4" />
              </a>
            </div>
          </div>
          <Pino />
        </div>

        <div class="numeros entrar" style="--i:7" data-contadores>
          {
            numeros.map((item) => (
              <div class="numero">
                <div class="numero-n">{item.n}</div>
                <div class="numero-l">{item.l}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ═══════ 2. CLIENTES ═══════ -->
    <section class="clientes" aria-labelledby="clientes-titulo">
      <h2 class="clientes-titulo" id="clientes-titulo">Empresas que já confiam no trabalho</h2>
      <div class="clientes-trilho">
        {
          [0, 1, 2].map((copia) => (
            <ul class="clientes-lista" aria-hidden={copia > 0 ? 'true' : undefined}>
              {clientes.map((c) => (
                <li class="cliente">
                  <LogoCliente logo={c.logo} nome={c.nome} bandeira={c.bandeira} />
                  <span>
                    <span class="cliente-nome block">{c.nome}</span>
                    <span class="cliente-ramo block">
                      {c.ramo} · {c.cidade}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </section>

    <!-- ═══════ 3. O PROBLEMA ═══════ -->
    <section class="secao clara" id="problema">
      <div class="caixa">
        <div class="revelar">
          <p class="selo">{problema.selo}</p>
          <h2 class="titulo">{problema.titulo}</h2>
          <p class="descricao">{problema.texto}</p>
        </div>

        <div class="dores">
          {
            problema.itens.map((dor, i) => (
              <article class="cartao dor revelar" style={`--i:${i % 3}`}>
                <span class="icone-caixa">
                  <Icon name={dor.icone as any} class="size-6" />
                </span>
                <h3>{dor.titulo}</h3>
                <p>{dor.texto}</p>
              </article>
            ))
          }
        </div>

        <div class="fecho revelar">
          <p>
            {problema.fecho[0]}<br /><span>{problema.fecho[1]}</span>
          </p>
          <a href="#servicos" class="botao botao-azul">
            Ver a solução
            <Icon name="arrow-right" class="seta size-4" />
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════ 4. SERVIÇOS E PROCESSO ═══════ -->
    <section class="secao marinho" id="servicos">
      <div class="caixa">
        <div class="servicos-topo revelar">
          <div>
            <p class="selo">{servicos.selo}</p>
            <h2 class="titulo">{servicos.titulo}</h2>
          </div>
          <p class="descricao">{servicos.texto}</p>
        </div>

        <div class="servicos">
          {
            servicos.itens.map((s, i) => (
              <article class="cartao servico inclinar revelar" style={`--i:${i % 2}`}>
                <span class="icone-caixa">
                  <Icon name={s.icone as any} class="size-6" />
                </span>
                <h3>{s.titulo}</h3>
                <p>{s.texto}</p>
                <details class="inclui">
                  <summary>
                    O que está incluído
                    <Icon name="chevron-down" class="size-4" />
                  </summary>
                  <ul>
                    {s.inclui.map((item) => (
                      <li>
                        <Icon name="check" class="size-4" />
                        {item}
                      </li>
                    ))}
                  </ul>
                </details>
              </article>
            ))
          }
        </div>

        <div class="mt-24 revelar">
          <p class="selo">{processo.selo}</p>
          <h2 class="titulo">{processo.titulo}</h2>
        </div>
        <ol class="processo" id="processo">
          <li class="processo-linha" aria-hidden="true"></li>
          {
            processo.passos.map((p, i) => (
              <li class="passo" style={`--i:${i}`}>
                <span class="passo-bola">
                  <Icon name={p.icone as any} class="size-6" />
                </span>
                <div>
                  <div class="passo-n">PASSO {String(i + 1).padStart(2, '0')}</div>
                  <h3>{p.titulo}</h3>
                  <p>{p.texto}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ═══════ 5. CASES ═══════ -->
    <section class="secao clara" id="cases">
      <div class="caixa">
        <div class="revelar">
          <p class="selo">{cases.selo}</p>
          <h2 class="titulo">{cases.titulo}</h2>
          <p class="descricao">{cases.texto}</p>
        </div>

        <div class="abas revelar" role="tablist" aria-label="Escolha um case" hidden data-abas>
          {
            cases.itens.map((c, i) => (
              <button class="aba" type="button" role="tab" id={`aba-${i}`} aria-controls={`case-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                {c.aba}
              </button>
            ))
          }
        </div>

        {
          cases.itens.map((c, i) => (
            <div class="case revelar" id={`case-${i}`} role="tabpanel" aria-labelledby={`aba-${i}`} data-contadores>
              <div class="case-topo">
                <div class="case-cabeca">
                  <LogoCliente logo={c.logo} nome={c.nome} bandeira={c.bandeira} altura={56} />
                  <div>
                    <h3 class="case-nome">{c.nome}</h3>
                    <p class="case-ramo">
                      {c.ramo} · {c.local}
                    </p>
                  </div>
                </div>
                <div class="etiquetas">
                  {c.canais.map((canal) => (
                    <span class="etiqueta">{canal}</span>
                  ))}
                </div>
              </div>
              <div class="case-corpo">
                <div class="metricas">
                  {c.metricas.map((m) => (
                    <div class="metrica">
                      <div class="metrica-n">{m.n}</div>
                      <div class="metrica-l">{m.l}</div>
                    </div>
                  ))}
                </div>
                <div class="partes">
                  {c.partes.map((parte) => (
                    <div class="parte">
                      <h4>{parte.titulo}</h4>
                      <p>{parte.texto}</p>
                    </div>
                  ))}
                </div>
                <blockquote class="citacao">
                  <Icon name="quote" class="size-5" />
                  <p>"{c.citacao}"</p>
                  <footer>— {c.autor}</footer>
                </blockquote>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ═══════ 6. DEPOIMENTOS E ANTES/DEPOIS ═══════ -->
    <section class="secao escura grade" id="depoimentos">
      <div class="caixa relative">
        <div class="revelar">
          <p class="selo">{depoimentos.selo}</p>
          <h2 class="titulo">{depoimentos.titulo}</h2>
          <p class="descricao">{depoimentos.texto}</p>
        </div>

        <div class="prints" id="prints">
          {
            prints.map((f, i) => (
              <figure class="print revelar" style={`--i:${i}`}>
                <button type="button" data-ampliar={i} aria-label={`Ampliar print: ${f.quem}`}>
                  <Image
                    src={f.img}
                    alt={`Print de mensagem do cliente com feedback sobre o trabalho (${f.quem})`}
                    widths={[300, 450, 600]}
                    sizes="(max-width: 639px) 70vw, (max-width: 959px) 42vw, 290px"
                    quality={72}
                  />
                  <span class="ampliar" aria-hidden="true">
                    <Icon name="zoom-in" class="size-4" />
                  </span>
                </button>
                <figcaption>{f.quem}</figcaption>
              </figure>
            ))
          }
        </div>
        <div class="prints-setas">
          <button class="seta-btn" type="button" data-rolar="-1" aria-label="Print anterior"><Icon name="chevron-left" /></button>
          <button class="seta-btn" type="button" data-rolar="1" aria-label="Próximo print"><Icon name="chevron-right" /></button>
        </div>

        <dialog class="lupa" id="lupa" aria-label="Print ampliado">
          {
            prints.map((f, i) => (
              <Image
                src={f.img}
                alt={`Print ampliado (${f.quem})`}
                width={900}
                quality={80}
                loading="lazy"
                data-lupa={i}
                hidden
              />
            ))
          }
          <button class="lupa-fechar" type="button" aria-label="Fechar"><Icon name="x" /></button>
        </dialog>

        <div class="mt-24 revelar">
          <p class="selo">{antesDepois.selo}</p>
          <h2 class="titulo">{antesDepois.titulo}</h2>
        </div>
        <div class="comparar">
          <div class="lado lado-antes revelar">
            <h3><Icon name="x" class="size-4" /> Antes</h3>
            <ul>
              {antesDepois.antes.map((item) => (
                <li>
                  <Icon name="x" class="size-5" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="lado lado-depois revelar" style="--i:1">
            <h3><Icon name="check" class="size-4" /> Depois</h3>
            <ul>
              {antesDepois.depois.map((item) => (
                <li>
                  <Icon name="check" class="size-5" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════ 7. SOBRE ═══════ -->
    <section class="secao branca" id="sobre">
      <div class="caixa">
        <div class="revelar">
          <p class="selo">{sobre.selo}</p>
          <h2 class="titulo">{sobre.titulo}</h2>
        </div>
        <div class="sobre">
          <div class="foto-moldura revelar">
            <Image src={perfil} alt="Victor Eduardo" widths={[400, 640, 840]} sizes="(max-width: 959px) 88vw, 420px" quality={78} />
            <div class="anos">
              <strong>{sobre.anos}</strong>
              <span>anos no<br />marketing</span>
            </div>
          </div>
          <div class="sobre-texto revelar" style="--i:1">
            {sobre.paragrafos.map((p) => <p set:html={p} />)}
            <ul class="credenciais">
              {sobre.credenciais.map((c) => (
                <li class="credencial">
                  <Icon name={c.icone as any} class="size-4" />
                  {c.texto}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════ 8. FAQ ═══════ -->
    <section class="secao clara" id="faq">
      <div class="caixa faq-grade">
        <div class="faq-cabeca revelar">
          <p class="selo">{faq.selo}</p>
          <h2 class="titulo">{faq.titulo}</h2>
          <p class="descricao">{faq.texto}</p>
        </div>
        <div class="perguntas">
          {
            faq.itens.map((item, i) => (
              <details class="pergunta revelar" style={`--i:${i}`} name="faq" open={i === 0}>
                <summary>
                  {item.p}
                  <span class="mais" aria-hidden="true">
                    <Icon name="chevron-down" class="size-4" />
                  </span>
                </summary>
                <p set:html={item.r} />
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <!-- ═══════ 9. CHAMADA FINAL E RODAPÉ ═══════ -->
  <footer class="secao escura grade final" id="contato">
    <div class="final-luz" aria-hidden="true"></div>
    <div class="caixa relative">
      <div class="revelar">
        <p class="selo">{chamadaFinal.selo}</p>
        <h2>
          {chamadaFinal.titulo[0]}<br /><span>{chamadaFinal.titulo[1]}</span>
        </h2>
        <p class="descricao">{chamadaFinal.texto}</p>
        <div class="final-botoes">
          <a href={contato.whatsappDiagnostico} class="botao botao-verde">
            <Icon name="whatsapp" />
            {chamadaFinal.botao}
          </a>
          <a href={`mailto:${contato.email}`} class="botao botao-vazado">
            <Icon name="mail" />
            Enviar e-mail
          </a>
        </div>
      </div>

      <div class="contatos text-left">
        <div class="contato-largo">
          <div class="contato-rotulo">WhatsApp</div>
          <a class="contato-valor" href={contato.whatsapp}><Icon name="whatsapp" class="size-4" />{contato.telefone}</a>
        </div>
        <div class="contato-largo">
          <div class="contato-rotulo">E-mail</div>
          <a class="contato-valor" href={`mailto:${contato.email}`}><Icon name="mail" class="size-4" />{contato.email}</a>
        </div>
        <div>
          <div class="contato-rotulo">Instagram</div>
          <a class="contato-valor" href={contato.instagram} target="_blank" rel="noopener"><Icon name="instagram" class="size-4" />{contato.arroba}</a>
        </div>
        <div>
          <div class="contato-rotulo">Localização</div>
          <span class="contato-valor"><Icon name="map-pin" class="size-4" />{contato.cidade}</span>
        </div>
      </div>

      <p class="direitos">© {new Date().getFullYear()} Victor Eduardo · Marketing para Serviços e Facilities · Todos os direitos reservados.</p>
    </div>
  </footer>

  <a href={contato.whatsappDiagnostico} class="zap" id="zap" aria-label="Falar no WhatsApp">
    <Icon name="whatsapp" class="size-7" />
  </a>
</Base>

<script>
  import { iniciar } from '../scripts/interacoes'
  iniciar()
</script>
